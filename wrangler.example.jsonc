{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Copy this to wrangler.jsonc and fill in the marked values.
  // wrangler.jsonc is gitignored, so your account details stay yours.

  "name": "ix-memory",
  "main": "src/worker.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MemoryMCP"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "MemoryMCP"
      }
    ]
  },

  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      // From `npx wrangler kv namespace create OAUTH_KV`.
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],

  // Not secret. Secrets are set with `wrangler secret put` — see the README.
  "vars": {
    // The GitHub repo where your memory is stored. It should be private.
    // The server only ever touches ix/memory/ inside it, so an existing
    // repo with other things in it is fine.
    "MEMORY_REPO_OWNER": "REPLACE_WITH_YOUR_GITHUB_USERNAME",
    "MEMORY_REPO_NAME": "REPLACE_WITH_YOUR_REPO_NAME",
    "MEMORY_REPO_BRANCH": "main",

    // Only this GitHub account may use the server. An authenticated
    // stranger is still a stranger.
    "ALLOWED_GITHUB_LOGIN": "REPLACE_WITH_YOUR_GITHUB_USERNAME"
  },

  "observability": {
    "enabled": true
  }
}
